{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "SahPaath DiagramSense processing infrastructure (drafts only)",
  "Parameters": {
    "BedrockModelId": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Verified image + forced-tool Converse model/profile ID; no default"
    },
    "BedrockResourceArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact model/profile ARNs needed by this model; include destination model ARNs for cross-region profiles"
    }
  },
  "Resources": {
    "DiagramBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            },
            {
              "Id": "ExpireResults",
              "Status": "Enabled",
              "Prefix": "results/",
              "ExpirationInDays": 30
            },
            {
              "Id": "ExpireSourceDiagrams",
              "Status": "Enabled",
              "Prefix": "diagrams/",
              "ExpirationInDays": 90
            }
          ]
        }
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DiagramBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DiagramBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DiagramBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "PipelineTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "jobId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "jobId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "PipelineWorker": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "CodeUri": "../.pipeline-build/",
        "Timeout": 600,
        "MemorySize": 512,
        "ReservedConcurrentExecutions": 2,
        "Environment": {
          "Variables": {
            "SAHPAATH_PIPELINE_MODE": "step_functions",
            "SAHPAATH_AWS_USE_ROLE": "true",
            "AWS_BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "SAHPAATH_PIPELINE_BUCKET": {
              "Ref": "DiagramBucket"
            },
            "SAHPAATH_PIPELINE_TABLE": {
              "Ref": "PipelineTable"
            }
          }
        },
        "Policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject"
                ],
                "Resource": [
                  {
                    "Fn::Sub": "${DiagramBucket.Arn}/diagrams/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "s3:PutObject"
                ],
                "Resource": [
                  {
                    "Fn::Sub": "${DiagramBucket.Arn}/results/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:GetItem",
                  "dynamodb:PutItem"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "PipelineTable",
                    "Arn"
                  ]
                }
              },
              {
                "Effect": "Allow",
                "Action": [
                  "textract:DetectDocumentText"
                ],
                "Resource": "*"
              },
              {
                "Effect": "Allow",
                "Action": [
                  "bedrock:InvokeModel"
                ],
                "Resource": {
                  "Ref": "BedrockResourceArns"
                }
              }
            ]
          }
        ],
        "Tracing": "Active"
      }
    },
    "DiagramPipeline": {
      "Type": "AWS::Serverless::StateMachine",
      "Properties": {
        "Type": "STANDARD",
        "Definition": {
          "Comment": "DiagramSense: private image -> OCR -> structured proposal -> validation -> draft persistence. No publish action.",
          "StartAt": "ProcessDiagram",
          "TimeoutSeconds": 660,
          "States": {
            "ProcessDiagram": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": {
                  "Fn::GetAtt": [
                    "PipelineWorker",
                    "Arn"
                  ]
                },
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                },
                {
                  "ErrorEquals": [
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ]
            }
          }
        },
        "Policies": [
          {
            "LambdaInvokePolicy": {
              "FunctionName": {
                "Ref": "PipelineWorker"
              }
            }
          }
        ],
        "Tracing": {
          "Enabled": true
        }
      }
    },
    "WorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${PipelineWorker}"
        },
        "RetentionInDays": 14
      }
    },
    "PipelineAlerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "SahPaath pipeline alerts"
      }
    },
    "PipelineAlertsPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "PipelineAlerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "events.amazonaws.com",
                  "cloudwatch.amazonaws.com"
                ]
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "PipelineAlerts"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "WorkerErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Diagram pipeline worker returned errors",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Statistic": "Sum",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "PipelineWorker"
            }
          }
        ],
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "PipelineAlerts"
          }
        ]
      }
    },
    "PipelineFailureRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Diagram pipeline execution failed or timed out",
        "EventPattern": {
          "source": [
            "aws.states"
          ],
          "detail-type": [
            "Step Functions Execution Status Change"
          ],
          "detail": {
            "status": [
              "FAILED",
              "TIMED_OUT",
              "ABORTED"
            ],
            "stateMachineArn": [
              {
                "Ref": "DiagramPipeline"
              }
            ]
          }
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Ref": "PipelineAlerts"
            },
            "Id": "PipelineAlertsTopic"
          }
        ]
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "DiagramBucket"
      }
    },
    "Table": {
      "Value": {
        "Ref": "PipelineTable"
      }
    },
    "StateMachineArn": {
      "Value": {
        "Ref": "DiagramPipeline"
      }
    },
    "AlertTopicArn": {
      "Description": "SNS topic carrying pipeline alarms and failures",
      "Value": {
        "Ref": "PipelineAlerts"
      }
    },
    "WorkerLogGroup": {
      "Description": "CloudWatch log group for the pipeline worker",
      "Value": {
        "Ref": "WorkerLogGroup"
      }
    }
  }
}
