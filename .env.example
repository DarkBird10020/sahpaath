# Optional local teacher password. Default development password: sahpaath-local
SAHPAATH_TEACHER_PASSWORD=replace-with-a-local-password
PORT=5173

# Optional real AWS pipeline for uploaded diagrams (Textract OCR + Bedrock
# analysis). Leave everything unset for the local demo: no network call is
# made and uploads fall back to the manual map editor.
# Static IAM credentials only; Bedrock API keys (ABSK...) are not supported here.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=only-for-temporary-credentials
# AWS_BEDROCK_MODEL_ID=an-model-id-enabled-in-your-account-and-region
# Do not put secrets in VITE_ variables.

# Optional durable cloud pipeline. Deploy infra/diagram-pipeline.json first.
# SAHPAATH_PIPELINE_MODE=step_functions
# SAHPAATH_PIPELINE_BUCKET=stack-output-bucket
# SAHPAATH_PIPELINE_TABLE=stack-output-table
# SAHPAATH_PIPELINE_STATE_MACHINE_ARN=stack-output-state-machine-arn
# Use the SDK credential chain / execution role instead of static keys:
# SAHPAATH_AWS_USE_ROLE=true

# Optional Polly audio for approved explorer descriptions (uses AWS_REGION and
# the credentials above). Off unless a voice is named. Audio is generated once
# per published version, cached under the data directory, and never blocks the
# text explorer. Verify the voice/engine in your region before enabling.
# SAHPAATH_POLLY_VOICE=Kajal
# SAHPAATH_POLLY_ENGINE=neural
# SAHPAATH_POLLY_LANGUAGE=en-IN

# Versioned backend (/api/v1); independent from the classroom pipeline above.
# Repository adapter: sqlite (default) | memory | dynamodb
SAHPAATH_STORE=sqlite
SAHPAATH_DATA_DIR=.data
SAHPAATH_LOG_LEVEL=info

# --- Upload grants ---
# Optional locally: a random process-only key is generated when unset.
# Set a stable secret to retain grants across restarts; required in cloud mode.
# HMAC secret for upload grants. Generate with: openssl rand -hex 32
# SAHPAATH_UPLOAD_TOKEN_SECRET=replace-with-a-random-secret
# Maximum upload size in bytes (default 5 MB demo cap).
# SAHPAATH_MAX_UPLOAD_BYTES=5000000
# Presigned upload grant lifetime in seconds (default 600, max 3600).
# SAHPAATH_PRESIGN_EXPIRES_SECONDS=600

# --- AWS (UNVERIFIED until an authenticated account exists) ---
# Never put real keys in this file or any committed file. Use your
# environment, AWS_PROFILE, or a secrets manager. The repository must
# never contain AWS keys.
# AWS_REGION=ap-south-1
# AWS_PROFILE=
# SAHPAATH_DDB_TABLE=sahpaath-main
# SAHPAATH_S3_BUCKET=
# Step Functions state machine for the diagram processing pipeline.
# SAHPAATH_SFN_STATE_MACHINE_ARN=

# --- DiagramSense processing (docs/DIAGRAM_PIPELINE.md) ---
# Model id is passed to Bedrock verbatim from configuration; never hardcoded
# in source. Capability of any given model is UNVERIFIED until validated.
# SAHPAATH_BEDROCK_MODEL_ID=
# SAHPAATH_BEDROCK_ENABLED=1
# SAHPAATH_TEXTRACT_ENABLED=1

# --- Test stand-in for Bedrock/Textract (docs/LOCAL_AI.md) ---
# Used only when AWS is not configured. OCR runs locally with tesseract.js;
# the proposal step calls the Google Gemini API free tier. Free-tier content
# may be used by Google to improve its products: send only openly licensed or
# self-made diagrams. Stage details always say "Test stand-in, not AWS".
# GEMINI_API_KEY=your-google-ai-studio-key
# SAHPAATH_GEMINI_MODEL=gemini-3.5-flash-lite

# --- YouTube search on the Watch & listen page ---
# A Google Cloud API key with the "YouTube Data API v3" enabled, restricted to
# that one API. Server-side only: never use a VITE_ prefix, or the key ships to
# every browser. Without it the page still takes uploaded files and subtitles;
# the search box reports that search is not configured.
# Quota: the free tier is 10,000 units a day for the whole server, and one
# search costs 101 (search.list 100 + videos.list 1), so roughly 99 searches a
# day shared by everyone. Repeat searches are answered from a 10-minute cache.
# Captions for a found video are written by Gemini reading the video from its
# public URL (GEMINI_API_KEY above); nothing is downloaded or re-hosted here.
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
